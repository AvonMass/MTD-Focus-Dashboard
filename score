(function(){
  const host=document.getElementById('tab-action');
  const fsms=DATA.meta.fsms; const G=GOALS;
  function scoreTech(t){
    const c=[];
    const pph=(t.pph_noPTO!=null)?t.pph_noPTO:t.pph;
    if(pph!=null&&pph<G.pph){const gap=G.pph-pph;const jobs=t.jobs||0;
      c.push({metric:'PPH',impact:gap*Math.min(jobs,60)/10,head:`PPH ${pph.toFixed(2)} vs 5.00`,sub:'PTO-removed',
        detail:`Gap ${gap.toFixed(2)} across ${jobs} jobs. Ride-along on job sequencing & pre-call routing; check for parts/truck-stock delays.`,low:false});}
    if(t.wo!=null&&t.wo<G.wo){const gap=G.wo-t.wo;const jobs=t.jobs||0;
      c.push({metric:'$/WO',impact:(gap/G.wo)*Math.min(jobs,60),head:`$${t.wo.toFixed(2)}/WO vs $33`,sub:'revenue per work order',
        detail:`Gap $${gap.toFixed(2)}/WO. Coach attach/upsell — SHS accessories, protection plans, whole-home. ${t.wo===0?'Currently $0 sold — start with one accessory per job.':''}`,low:false});}
    if(t.dcr!=null&&t.dcr<G.dcr){const gap=G.dcr-t.dcr;const jobs=t.jobs||0;
      c.push({metric:'DCR',impact:gap*100*Math.min(jobs,60)/20,head:`DCR ${(t.dcr*100).toFixed(1)}% vs 90%`,sub:'completion rate',
        detail:`Gap ${(gap*100).toFixed(1)} pts. ${t.cancels} cancels / ${t.reschedules} reschedules. Review cancel reasons & pre-visit confirmation calls.`,low:false});}
    if(t.r12_rate>G.r12){const gap=t.r12_rate-G.r12;const reps=t.r12_repeats;const low=(t.completed||0)<15;
      c.push({metric:'R12',impact:gap*100*reps*(low?0.4:1),head:`R12 ${(t.r12_rate*100).toFixed(1)}% vs 4%`,sub:`${reps} repeat WO${reps===1?'':'s'}`,
        detail:`${low?'\u26a0 Low job sample — weight lightly. ':''}Avg ${t.r12_avg_days??'—'} days between visits. Review repeat reasons (pointing/cabling/LNBF) for first-visit-fix quality.`,low:low});}
    if(t.nps!=null&&t.nps<G.nps){const gap=G.nps-t.nps;const sc=t.nps_surveys||0;const low=sc<3;
      c.push({metric:'NPS',impact:(gap/100)*Math.max(sc,1)*(low?0.3:1)*10,head:`NPS ${t.nps.toFixed(0)} vs 95`,sub:`${sc} survey${sc===1?'':'s'}`,
        detail:`${low?'\u26a0 Low survey sample ('+sc+') — confirm before coaching hard. ':''}Review arrival/communication & customer-education scores; set expectations on-site.`,low:low});}
    return c;
  }
  host.innerHTML='<h2 class="sec">Action Plan — top 3 coaching conversations per FSM</h2>'+
    '<div class="note" style="margin:0 0 16px">Ranked by coaching <b>impact</b> = gap size \u00d7 volume leverage. Tiny samples are down-weighted (a 1-survey NPS or a 2-repeat R12 on few jobs won\u2019t outrank a real, high-volume gap). PPH uses the <b>PTO-removed</b> figure so time off isn\u2019t mistaken for low productivity. \u26a0 marks a low-sample caveat.</div>';

  fsms.forEach(fsm=>{
    const all=[];
    snap.techs.filter(t=>t.fsm===fsm).forEach(t=>{
      scoreTech(t).forEach(c=>all.push(Object.assign({tech:t.name},c)));
    });
    all.sort((a,b)=>b.impact-a.impact);
    // one conversation per tech: keep each tech's single highest-impact gap, then take top 3 techs
    const seen=new Set(); const top=[];
    for(const c of all){ if(seen.has(c.tech))continue; seen.add(c.tech); top.push(c); if(top.length===3)break; }
    const sec=document.createElement('div'); sec.className='panel'; sec.style.marginBottom='16px';
    let h=`<div style="font-size:15px;font-weight:700;margin-bottom:12px">${fsm} <span style="color:var(--muted);font-size:12px;font-weight:400">— this week\u2019s 3 highest-impact conversations</span></div>`;
    top.forEach((c,i)=>{
      h+=`<div style="display:flex;gap:14px;padding:13px;background:var(--panel2);border:1px solid var(--line);border-left:4px solid var(--red);border-radius:10px;margin-bottom:10px">
        <div style="font-size:26px;font-weight:800;color:var(--red);font-family:var(--mono);min-width:34px">${i+1}</div>
        <div style="flex:1">
          <div style="display:flex;align-items:baseline;gap:10px;flex-wrap:wrap">
            <span style="font-weight:700;font-size:15px">${c.tech}</span>
            <span style="font-size:11px;font-weight:700;color:var(--rd);background:var(--red-bg);padding:2px 8px;border-radius:20px">${c.metric}</span>
            <span style="font-family:var(--mono);color:var(--rd);font-weight:700">${c.head}</span>
            <span style="font-size:11px;color:var(--muted)">${c.sub}</span>
          </div>
          <div style="margin-top:6px;font-size:13px;color:#d6d6d6;line-height:1.5">${c.detail}</div>
        </div></div>`;
    });
    sec.innerHTML=h; host.appendChild(sec);
  });
})();



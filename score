// ===== MOST IMPROVED =====
(function(){
  const host=document.getElementById('tab-improved');
  const fsms=DATA.meta.fsms;
  // find prior-month final snapshot (tagged). Current = latest snapshot.
  const finals=DATA.snapshots.filter(s=>s.is_month_end_final);
  const cur=DATA.snapshots[DATA.snapshots.length-1];
  // a usable prior final is one BEFORE the current snapshot
  const priorFinal = finals.filter(s=>s.snapshot_date < cur.snapshot_date).slice(-1)[0] || null;

  // composite improvement score across the 5 goals (normalized gain toward goal)
  const G=GOALS;
  function goalDist(k,v){ if(v==null)return null;
    if(k==='r12')return (G.r12 - v);            // positive = better than goal
    if(k==='dcr')return (v - G.dcr);
    if(k==='pph')return (v - G.pph)/G.pph;
    if(k==='wo')return (v - G.wo)/G.wo;
    if(k==='nps')return (v - G.nps)/G.nps;
  }
  function improveScore(curT,priorT){
    const ks=['pph','wo','dcr','r12','nps']; let sum=0,n=0;
    ks.forEach(k=>{
      const cv=(k==='r12')?curT.r12_rate:curT[k];
      const pv=priorT?((k==='r12')?priorT.r12_rate:priorT[k]):null;
      if(cv==null||pv==null)return;
      let gain;
      if(k==='r12') gain=(pv-cv);         // r12 down = improvement
      else if(k==='dcr') gain=(cv-pv);
      else gain=(cv-pv)/(Math.abs(pv)||1);
      sum+=gain; n++;
    });
    return n? sum : null;
  }

  host.innerHTML='<h2 class="sec">Most Improved — top 3 per team vs last month\u2019s final</h2>';

  if(!priorFinal){
    host.innerHTML += `<div class="note" style="margin-bottom:18px">
      <b>Baseline week — gains populate next upload.</b> This is your first snapshot (${cur.label}, tagged as the starting month-end final),
      so there\u2019s no <i>previous</i> month final to measure gains against yet. The ranking engine is built and ready:
      upload next week\u2019s scorecard (or a true month-end file) and this tab will rank the top 3 improvers per team with real \u201c+X\u201d deltas.</div>`;
    // Show the roster per team so the tab isn't empty, with a "ready to rank" chip
    fsms.forEach(fsm=>{
      const techs=cur.techs.filter(t=>t.fsm===fsm).sort((a,b)=>(b.jobs||0)-(a.jobs||0)).slice(0,3);
      const sec=document.createElement('div'); sec.className='panel'; sec.style.marginBottom='16px';
      let h=`<div style="font-size:15px;font-weight:700;margin-bottom:10px">${fsm} <span style="color:var(--muted);font-size:12px;font-weight:400">— current top activity (ranking preview)</span></div>`;
      h+='<div style="display:grid;grid-template-columns:repeat(3,1fr);gap:12px">';
      const medals=['\ud83e\udd47','\ud83e\udd48','\ud83e\udd49'];
      techs.forEach((t,i)=>{
        h+=`<div style="background:var(--panel2);border:1px solid var(--line);border-radius:11px;padding:14px">
          <div style="font-size:22px">${medals[i]||''}</div>
          <div style="font-weight:700;margin:4px 0">${t.name}</div>
          <div style="font-size:12px;color:var(--muted)">PPH ${t.pph?.toFixed(2)??'—'} · $/WO ${t.wo!=null?'$'+t.wo.toFixed(0):'—'} · NPS ${t.nps??'—'}</div>
          <div style="margin-top:8px"><span style="font-size:11px;color:var(--amber);background:var(--amber-bg);padding:3px 8px;border-radius:20px">awaiting prior final</span></div>
        </div>`;
      });
      h+='</div>'; sec.innerHTML=h; host.appendChild(sec);
    });
    return;
  }

  // real ranking (runs once 2+ snapshots exist)
  fsms.forEach(fsm=>{
    const rows=cur.techs.filter(t=>t.fsm===fsm).map(t=>{
      const p=priorFinal.techs.find(x=>x.key===t.key);
      return {t,score:improveScore(t,p),prior:p};
    }).filter(r=>r.score!=null).sort((a,b)=>b.score-a.score).slice(0,3);
    const sec=document.createElement('div'); sec.className='panel'; sec.style.marginBottom='16px';
    let h=`<div style="font-size:15px;font-weight:700;margin-bottom:10px">${fsm}</div>`;
    h+='<div style="display:grid;grid-template-columns:repeat(3,1fr);gap:12px">';
    const medals=['\ud83e\udd47','\ud83e\udd48','\ud83e\udd49'];
    rows.forEach((r,i)=>{
      const t=r.t,p=r.prior;
      const dpph=(p&&t.pph!=null&&p.pph!=null)?(t.pph-p.pph):null;
      h+=`<div style="background:var(--panel2);border:1px solid var(--line);border-radius:11px;padding:14px">
        <div style="font-size:22px">${medals[i]||''}</div>
        <div style="font-weight:700;margin:4px 0">${t.name}</div>
        <div style="font-size:12px;color:var(--green)">${dpph!=null?(dpph>=0?'+':'')+dpph.toFixed(2)+' PPH':''}</div>
        <div style="font-size:12px;color:var(--muted);margin-top:4px">improvement score ${r.score.toFixed(2)}</div>
      </div>`;
    });
    h+='</div>'; sec.innerHTML=h; host.appendChild(sec);
  });
})();



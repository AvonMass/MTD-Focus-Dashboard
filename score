  lines.push(`FOCUS THIS WEEK`);
  lines.push(`  \u2022 DCR is our biggest office gap (${(ob.dcr*100).toFixed(1)}% vs 90%) \u2014 tighten pre-visit confirmations and cancel recovery.`);
  lines.push(`  \u2022 NPS (${ob.nps.toFixed(1)} vs 95) \u2014 reinforce arrival windows and customer education on every job.`);
  lines.push(`  \u2022 Attach/upsell is wide open \u2014 no tech is earning Pi attach points yet.`);
  DATA.meta.fsms.forEach(fsm=>{
    const f=topFocus(fsm);
    if(f) lines.push(`  \u2022 ${fsm.split(' ')[0]==='Michael'?'Zaffino':'Morris'}'s team top target: ${f}.`);
  });
  lines.push(``);
  lines.push(`Full per-tech breakdown, coaching targets, and path-to-goal are in the live dashboard:`);
  lines.push(DASH);
  lines.push(``);
  lines.push(`\u2014 James Morris, Operations Manager`);
  const BODY=lines.join('\n');

  // Gmail compose URL: subject in URL, BODY NOT in URL (avoids Bad Request on long bodies)
  const gmailURL=`https://mail.google.com/mail/?view=cm&fs=1&to=${encodeURIComponent(TO)}&su=${encodeURIComponent(SUBJECT)}`;

  host.innerHTML=`<h2 class="sec">Email \u2014 copy-ready FSM update</h2>
    <div class="note" style="margin:0 0 16px">One click: opens a Gmail compose window pre-addressed to <b>${TO}</b> with the subject filled in, and copies the full email below to your clipboard. In the Gmail window, click the body and press <b>Ctrl+V</b> to paste. (The body is intentionally kept out of the link \u2014 a long body in the URL triggers Gmail\u2019s \u201cBad Request\u201d error.)</div>
    <div class="panel">
      <div style="display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin-bottom:14px">
        <button id="gmailBtn" style="background:var(--red);color:#fff;border:none;border-radius:9px;padding:12px 20px;font-size:14px;font-weight:700;cursor:pointer;display:flex;align-items:center;gap:8px">
          \u2709 Open Gmail &amp; copy email
        </button>
        <button id="copyOnly" style="background:var(--panel2);color:#fff;border:1px solid var(--line);border-radius:9px;padding:12px 16px;font-size:13px;cursor:pointer">Copy text only</button>
        <span id="copyMsg" style="font-size:13px;color:var(--green);opacity:0;transition:opacity .2s">\u2713 Copied to clipboard</span>
      </div>
      <div style="font-size:12px;color:var(--muted);margin-bottom:6px">TO: ${TO} &nbsp;|&nbsp; SUBJECT: ${SUBJECT}</div>
      <pre id="emailBody" style="white-space:pre-wrap;background:var(--black);border:1px solid var(--line);border-radius:10px;padding:16px;font-family:var(--mono);font-size:13px;line-height:1.55;color:#e6e6e6;margin:0;overflow-x:auto"></pre>
    </div>`;
  document.getElementById('emailBody').textContent=BODY;

  function copyBody(){
    navigator.clipboard.writeText(BODY).then(()=>{
      const m=document.getElementById('copyMsg'); m.style.opacity='1'; setTimeout(()=>m.style.opacity='0',2200);
    }).catch(()=>{
      // fallback
      const ta=document.createElement('textarea'); ta.value=BODY; document.body.appendChild(ta); ta.select();
      try{document.execCommand('copy');}catch(e){} document.body.removeChild(ta);
      const m=document.getElementById('copyMsg'); m.style.opacity='1'; setTimeout(()=>m.style.opacity='0',2200);
    });
  }
  document.getElementById('gmailBtn').onclick=()=>{ copyBody(); window.open(gmailURL,'_blank'); };
  document.getElementById('copyOnly').onclick=copyBody;
})();



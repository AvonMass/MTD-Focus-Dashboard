    if(t.dcr!=null&&t.dcr<G.dcr&&t.completed){
      const j=t.completed/t.dcr; const need=ceil(G.dcr*j - t.completed);
      out.push({m:'DCR',txt:`+${need} completion${need===1?'':'s'}`,sub:`${(t.dcr*100).toFixed(1)}% \u2192 90% (no new cancels)`});
    }
    // $/WO -> extra revenue
    if(t.wo!=null&&t.wo<G.wo){
      const extra=(G.wo-t.wo)*(t.jobs||0);
      out.push({m:'$/WO',txt:`+$${extra.toLocaleString(undefined,{maximumFractionDigits:0})} revenue`,sub:`$${t.wo.toFixed(2)} \u2192 $33 /WO on ${t.jobs||0} jobs`});
    }
    // R12 -> repeats to remove
    if(t.r12_rate>G.r12&&t.completed){
      const maxRep=G.r12*t.completed; const remove=ceil(t.r12_repeats-maxRep);
      out.push({m:'R12',txt:`${remove>0?'\u2212'+remove+' repeat'+(remove===1?'':'s'):'hold repeats'}`,sub:`${(t.r12_rate*100).toFixed(1)}% \u2192 \u22644% (${t.r12_repeats} repeats on ${t.completed} done)${(t.completed<15)?' \u26a0 low sample':''}`});
    }
    // NPS -> perfect surveys needed
    if(t.nps!=null&&t.nps<G.nps&&t.nps_surveys){
      const k=ceil(t.nps_surveys*(G.nps-t.nps)/5);
      out.push({m:'NPS',txt:`+${k} perfect survey${k===1?'':'s'}`,sub:`${t.nps.toFixed(0)} \u2192 95 on ${t.nps_surveys} survey${t.nps_surveys===1?'':'s'}${t.nps_surveys<3?' \u26a0 low sample':''}`});
    }
    // PPH -> extra points
    const pph=(t.pph_noPTO!=null)?t.pph_noPTO:t.pph;
    if(pph!=null&&pph<G.pph){
      out.push({m:'PPH',txt:`lift ${(G.pph-pph).toFixed(2)} pph`,sub:`${pph.toFixed(2)} \u2192 5.00 (PTO-removed)`});
    }
    return out;
  }

  host.innerHTML='<h2 class="sec">Path to Goal — what it takes to close each gap</h2>'+
    '<div class="note" style="margin:0 0 16px">Every goal gap translated into a concrete target: completions, revenue, repeats to eliminate, or perfect surveys. DCR holds jobs fixed (close the gap by finishing, not by booking more). NPS assumes new perfect (100) surveys \u2014 real coaching also converts detractors, which moves faster. \u26a0 = thin sample, treat as directional.</div>';

  // OFFICE strip
  const ob=snap.office.baseline;
  const n=snap.techs.reduce((a,t)=>a+(t.nps_surveys||0),0);
  const comp=Math.round(ob.dcr*ob.jobs);
  const offCards=[];
  offCards.push(['DCR', ob.dcr<G.dcr? `+${ceil(G.dcr*ob.jobs-comp)} completions`:'\u2713 at goal', `${(ob.dcr*100).toFixed(1)}% of ${ob.jobs} jobs`]);
  offCards.push(['NPS', ob.nps<G.nps? `+${ceil(n*(G.nps-ob.nps)/5)} perfect surveys`:'\u2713 at goal', `${ob.nps.toFixed(1)} on ${n} surveys`]);
  offCards.push(['$/WO', ob.wo>=G.wo?'\u2713 over goal':`+$${((G.wo-ob.wo)*ob.jobs).toLocaleString()} rev`, `$${ob.wo.toFixed(2)} /WO`]);
  offCards.push(['PPH', ob.pph>=G.pph?'\u2713 over goal':`lift ${(G.pph-ob.pph).toFixed(2)}`, `${ob.pph.toFixed(2)} pph`]);
  offCards.push(['R12', ob.r12<=G.r12?'\u2713 under goal':`cut repeats`, `${(ob.r12*100).toFixed(2)}%`]);
  let oh='<div class="panel" style="margin-bottom:18px"><div style="font-size:15px;font-weight:700;margin-bottom:10px">Office — Avon Dominators</div><div style="display:grid;grid-template-columns:repeat(5,1fr);gap:10px">';
  offCards.forEach(([lbl,big,sub])=>{
